<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <h2><%= organizationDetails.name %></h2>

    <p>Description: <%= organizationDetails.description %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a class="edit-link" href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>
    <% } %>

    <h3>Service Projects</h3>

    <ul>

        <% projects.forEach(project => { %>

            <li>
                <a class="project-card-link" href="/projects/<%= project.project_id %>">
                    <h3><%= project.title %></h3>
                </a>
            </li>

        <% }) %>

    </ul>

</main>

<%- include('partials/footer') %>