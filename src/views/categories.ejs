<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% if (user && user.role_name === 'admin') { %>
        <a class="add-new-link" href="/new-category">Add a New Category</a>
    <% } %>

    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a class="category-link" href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
                <% if (user && user.role_name === 'admin') { %>
                    <a class="edit-link" href="/edit-category/<%= category.category_id %>">Edit</a>
                <% } %>
            </li>
        <% }); %>
    </ul>
    
</main>

<%- include('partials/footer') %>