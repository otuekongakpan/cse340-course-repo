<%- include('partials/header') %>

<main>
    <h1><%= projectDetails.title %></h1>

    <p>
        <strong>Description:</strong>
        <%= projectDetails.description %>
    </p>

    <p>
        <strong>Date:</strong>
        <%= new Date(projectDetails.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        }) %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= projectDetails.location %>
    </p>

    <p>
        <strong>Partner Organization:</strong>
        <a class="project-organization"
        href="/organization/<%= projectDetails.organization_id %>">
            <%= projectDetails.organization_name %>
        </a>
    </p>

    <% if (isLoggedIn) { %>
        <% if (isVolunteering) { %>
            <div class="volunteer-status">
                <p>✓ You are volunteering for this project</p>
                <form class="volunteer-form inline" action="/projects/<%= projectDetails.project_id %>/unvolunteer" method="POST">
                    <input type="hidden" name="redirectTo" value="project">
                    <button type="submit" class="volunteer-btn remove">Remove Myself as Volunteer</button>
                </form>
            </div>
        <% } else { %>
            <form class="volunteer-form" action="/projects/<%= projectDetails.project_id %>/volunteer" method="POST">
                <button type="submit" class="volunteer-btn">Volunteer for This Project</button>
            </form>
        <% } %>
    <% } %>

    <div class="category-tags">
    <strong>Categories:</strong>
    <% categories.forEach(category => { %>
        <a class="category-tag" href="/category/<%= category.category_id %>">
            <%= category.name %>
        </a>
    <% }) %>
</div>

<% if (user && user.role_name === 'admin') { %>
    <p>
        <a class="edit-link" href="/edit-projects/<%= projectDetails.project_id %>">Edit Project</a>
    </p>
    <p>
        <a class="add-new-link" href="/assign-categories/<%= projectDetails.project_id %>">Assign Categories</a>
    </p>
<% } %>

</main>

<%- include('partials/footer') %>