<%- include('partials/header') %>

<main>
    <h1><%= projectDetails.title %></h1>

    <p>
        <strong>Description:</strong>
        <%= projectDetails.description %>
    </p>

    <p>
        <strong>Date:</strong>
        <%= new Date(projectDetails.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        }) %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= projectDetails.location %>
    </p>

    <p>
        <strong>Partner Organization:</strong>
        <a class="project-organization"
        href="/organization/<%= projectDetails.organization_id %>">
            <%= projectDetails.organization_name %>
        </a>
    </p>

    <div class="category-tags">
    <strong>Categories:</strong>
    <% categories.forEach(category => { %>
        <a class="category-tag" href="/category/<%= category.category_id %>">
            <%= category.name %>
        </a>
    <% }) %>
</div>

</main>

<%- include('partials/footer') %>