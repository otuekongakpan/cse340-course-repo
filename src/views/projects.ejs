<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <h2>Our Service Projects</h2>
        <ul>
            <% projects.forEach(project => { %>
                <% 
                    const formattedDate = new Date(project.project_date).toLocaleDateString('en-US', { 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric' 
                    }); 
                %>
                <li><%= formattedDate %>: <%= project.title %> (<%= project.organization_name %>)</li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>