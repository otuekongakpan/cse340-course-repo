<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View All Users</a></p>
    <% } %>

    <h3>My Volunteer Projects</h3>
    <% if (volunteeredProjects.length === 0) { %>
        <p class="no-volunteer-projects">You haven't signed up to volunteer for any projects yet.</p>
    <% } else { %>
        <ul class="volunteer-list">
            <% volunteeredProjects.forEach(project => { %>
                <li>
                    <a href="/projects/<%= project.project_id %>"><%= project.title %></a>
                    <span class="volunteer-date">
                        <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </span>
                    <form class="volunteer-form inline" action="/projects/<%= project.project_id %>/unvolunteer" method="POST">
                        <input type="hidden" name="redirectTo" value="dashboard">
                        <button type="submit" class="volunteer-btn remove">Remove</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% } %>

</main>

<%- include('partials/footer') %>